---
import Icon from "@components/Icon.astro";

import { formatPostDateForDisplay } from "../utils/date-utils";
import { isViewCounterEnabled } from "../utils/view-counter";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	hideUpdateDate?: boolean;
	hidePublishedDate?: boolean;
	slug?: string;
	showTime?: boolean;
	tags?: string[];
	/** 可建落地页的标签（文章数 >= 2）；不在其中的标签只显示为纯文本 */
	linkableTags?: string[];
}
const {
	published,
	updated,
	tags = [],
	linkableTags = [],
	hideUpdateDate = false,
	hidePublishedDate = false,
	slug,
	showTime = true,
} = Astro.props;
const className = Astro.props.class;
---

<div class:list={["flex flex-wrap text-neutral-400 items-center gap-4 gap-x-4 gap-y-2", className]}>
    <!-- publish date -->
    {!hidePublishedDate && (
        <div class="flex items-center">
            <div class="meta-icon">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-xl"></Icon>
            </div>
            <span class="text-50 text-sm font-medium">{formatPostDateForDisplay(published, showTime)}</span>
        </div>
    )}

    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
            <div class="meta-icon"
            >
                <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-xl"></Icon>
            </div>
            <span class="text-50 text-sm font-medium">{formatPostDateForDisplay(updated, showTime)}</span>
        </div>
    )}

    <!-- tags：只有 >=2 篇文章的标签才链接到落地页，避免薄内容聚合页 -->
    {tags.length > 0 && (
        <div class="flex items-center flex-wrap gap-2">
            <div class="meta-icon">
                <Icon name="material-symbols:label-outline-rounded" class="text-xl"></Icon>
            </div>
            {tags.map((tag) => {
                const href = `/tags/${encodeURIComponent(tag)}/`;
                return linkableTags.includes(tag)
                    ? <a href={href} class="text-xs px-2 py-0.5 rounded border border-white/15 hover:border-[var(--primary)]/60 hover:text-[var(--primary)] transition-colors">{tag}</a>
                    : <span class="text-xs px-2 py-0.5 rounded border border-white/10 text-50">{tag}</span>;
            })}
        </div>
    )}

    <!-- page views & visitors -->
    {slug && (
        <>
            <div class="flex items-center" id={`page-views-wrapper-${slug}`} style="display: none;">
                <div class="meta-icon">
                    <Icon name="material-symbols:visibility-outline-rounded" class="text-xl"></Icon>
                </div>
                <span class="text-50 text-sm font-medium" id={`page-views-${slug}`}></span>
            </div>
            <!--
            <div class="flex items-center">
                <div class="meta-icon">
                    <Icon name="material-symbols:person" class="text-xl"></Icon>
                </div>
                <span class="text-50 text-sm font-medium" id={`page-visitors-${slug}`}>0 人</span>
            </div>
            -->
        </>
    )}
</div>

{slug && isViewCounterEnabled() && (
    <script is:inline define:vars={{ slug }}>
    // 只登记「本页需要展示浏览量」的文章，真正的取数由 view-counter-runtime.ts 统一负责：
    // 优先 Umami 分享接口，失败或查不到时回落到自建接口（POST /batch）。
    window.__VIEWS_QUEUE__ = window.__VIEWS_QUEUE__ || [];
    if (!window.__VIEWS_QUEUE__.includes(slug)) {
        window.__VIEWS_QUEUE__.push(slug);
    }
</script>
)}
