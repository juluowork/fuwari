---
import { analyticsConfig, cookieConsentConfig, umamiConfig, viewCounterConfig } from "@/config";

// GA4 / Clarity 的加载时机："none" 直接加载（当前取值），"tracking" 等横幅同意后再加载
const analyticsConsentLevel = analyticsConfig.consentLevel ?? "none";
const analyticsGated = analyticsConsentLevel === "tracking";
const gaId = analyticsConfig.enable ? (analyticsConfig.gaMeasurementId ?? "") : "";
const clarityId = analyticsConfig.enable ? (analyticsConfig.clarityProjectId ?? "") : "";
---

<!-- preload：横幅脚本 66KB，等到 DOMContentLoaded 才开始下载会把「大块文本」的出现时间
     推到 7 秒之后，而 LCP 会一直等那个大块。提前预取可让它早一点出现。 -->
<link rel="preload" as="script" href="https://www.termsfeed.com/public/cookie-consent/4.2.0/cookie-consent.js" crossorigin>
<link rel="preconnect" href="https://www.termsfeed.com" crossorigin>
<link rel="preconnect" href="https://www.googletagmanager.com">

<script type="text/javascript">
(function () {
	const load = () => {
		if (window.__cookieConsentScriptLoaded) return;
		window.__cookieConsentScriptLoaded = true;
		const script = document.createElement("script");
		script.src = "https://www.termsfeed.com/public/cookie-consent/4.2.0/cookie-consent.js";
		script.charset = "UTF-8";
		script.async = true;
		document.head.appendChild(script);
	};
	// DOMContentLoaded 就加载：等 load 会让横幅 12s 才出现、顶替 LCP（12.1s → 7.2s）。
	if (document.readyState !== "loading") {
		load();
		return;
	}
	document.addEventListener("DOMContentLoaded", load, { once: true });
})();
</script>
<!-- ⚠️ 这个脚本必须用 is:inline + define:vars：
     非 inline 的 <script> 会被 Astro 当模块打包，**拿不到 frontmatter 里的变量**，
     之前写成 `<script type="text/javascript">` 时这里一执行就抛
     `cookieConsentConfig is not defined`，整个 IIFE 挂掉 → cc.run() 从没执行 →
     Cookie 横幅从来没弹过，连带下面 consentLevel=tracking 的第三方脚本也永远不会加载。 -->
<script is:inline define:vars={{ cookieConsentConfig }}>
(function () {
	const getPalette = () => {
		return "dark";
	};

	const baseConfig = {
		notice_banner_type: "simple",
		// implied = opt-out（默认同意）。详见 docs/seo.md「Cookie 同意」一节。
		consent_type: "implied",
		language: cookieConsentConfig.language || "en",
		// 这个列表同时决定「哪些类别算默认已接受」，四个都列以匹配「默认开启」的定位。
		page_load_consent_levels: [
			"strictly-necessary",
			"functionality",
			"tracking",
			"targeting",
		],
		notice_banner_reject_button_hide: false,
		preferences_center_close_button_hide: false,
		page_refresh_confirmation_buttons: false,
		website_name: cookieConsentConfig.siteName,
		website_privacy_policy_url: cookieConsentConfig.privacyPolicyUrl,
		open_preferences_center_selector: "#open_preferences_center",
	};

	// 紧凑横幅：默认 360x490 比正文大且最晚出现，会顶替 LCP；→ 320x137（详见 docs/baseline.md）。
	const COMPACT_BANNER_CSS = `
		@media (max-width: 767px) {
			.termsfeed-com---nb { max-width: 320px !important; }
			.termsfeed-com---nb .cc-nb-main-container { padding: 10px 12px !important; }
			.termsfeed-com---nb .cc-nb-title { font-size: 13px !important; line-height: 1.3 !important; margin: 0 0 4px !important; }
			.termsfeed-com---nb .cc-nb-text { font-size: 11px !important; line-height: 1.35 !important; margin: 0 !important;
				display: -webkit-box !important; -webkit-line-clamp: 2 !important; -webkit-box-orient: vertical !important; overflow: hidden !important; }
			.termsfeed-com---nb .cc-nb-buttons { margin-top: 6px !important; }
			.termsfeed-com---nb .cc-nb-okagree,
			.termsfeed-com---nb .cc-nb-changep,
			.termsfeed-com---nb .cc-nb-reject { padding: 6px 10px !important; font-size: 12px !important; }
			[class*="termsfeed-com---palette-"] .cc-nb-okagree { background: var(--primary) !important; color: #111 !important; }
		}
	`;

	const injectCompactBannerCss = () => {
		if (document.getElementById("cc-compact-style")) return;
		const style = document.createElement("style");
		style.id = "cc-compact-style";
		style.textContent = COMPACT_BANNER_CSS;
		document.head.appendChild(style);
	};

	const PERSISTENT_ATTR = "data-cookie-consent-persistent";

	const markCookieConsentHeadAssetsPersistent = () => {
		const candidates = document.head?.querySelectorAll?.("link[rel='stylesheet'][href], style, script[src]") ?? [];
		candidates.forEach(el => {
			if (!(el instanceof HTMLElement)) return;

			const tag = el.tagName.toLowerCase();
			if (tag === "link") {
				const href = el.getAttribute("href") || "";
				if (/termsfeed|cookie-consent|cookieconsent/i.test(href)) el.setAttribute(PERSISTENT_ATTR, "");
				return;
			}
			if (tag === "script") {
				const src = el.getAttribute("src") || "";
				if (/termsfeed|cookie-consent|cookieconsent/i.test(src)) el.setAttribute(PERSISTENT_ATTR, "");
				return;
			}
			if (tag === "style") {
				const css = el.textContent || "";
				if (
					/termsfeed-com---/.test(css) ||
					/\bcc-(nb|pc|cp)\b/.test(css) ||
					/\bcc_(dialog|preferences|cp|nb|overlay|banner|modal)\b/.test(css) ||
					/cookie\s*consent|cookieconsent/i.test(css)
				) {
					el.setAttribute(PERSISTENT_ATTR, "");
				}
			}
		});
	};

	let scheduled = false;
	const scheduleApplyPalette = () => {
		if (scheduled) return;
		scheduled = true;
		requestAnimationFrame(() => {
			scheduled = false;
			const palette = getPalette();
			document
				.querySelectorAll("[class*='termsfeed-com---palette-']")
				.forEach(el => {
					Array.from(el.classList)
						.filter(className => className.startsWith("termsfeed-com---palette-"))
						.forEach(className => el.classList.remove(className));
					el.classList.add(`termsfeed-com---palette-${palette}`);
				});
			document
				.querySelectorAll(
					".cc_dialog, .cc_preferences, .cc_cp, .cc_nb, .cc_overlay, .cc_banner, .cc_modal",
				)
				.forEach(el => {
					Array.from(el.classList)
						.filter(className => className === "dark")
						.forEach(className => el.classList.remove(className));
					el.classList.add("dark");
				});
		});
	};

	const runCookieConsent = () => {
		const cc = window.cookieconsent;
		if (!cc || typeof cc.run !== "function") return;
		injectCompactBannerCss();
		cc.run({ ...baseConfig, palette: getPalette() });
		scheduleApplyPalette();
	};

	const ensureCookieConsentRun = () => {
		const cc = window.cookieconsent;
		if (cc && typeof cc.run === "function") {
			runCookieConsent();
			return;
		}
		requestAnimationFrame(ensureCookieConsentRun);
	};

	// 页脚的「更新您的Cookie」入口：点击后打开偏好设置中心
	const bindPreferencesCenterEntry = () => {
		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (!target.closest("#open_preferences_center")) return;
			const cc = window.cookieconsent;
			if (cc && typeof cc.openPreferencesCenter === "function") {
				event.preventDefault();
				cc.openPreferencesCenter();
			}
		});
	};

	document.addEventListener("DOMContentLoaded", () => {
		markCookieConsentHeadAssetsPersistent();
		new MutationObserver(markCookieConsentHeadAssetsPersistent).observe(document.head, {
			childList: true,
			subtree: true,
		});

		ensureCookieConsentRun();
		bindPreferencesCenterEntry();

		new MutationObserver(scheduleApplyPalette).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		new MutationObserver(scheduleApplyPalette).observe(document.body, {
			childList: true,
			subtree: true,
		});
	});
})();
</script>

<!-- 浏览量上报（自建服务 t.peroe.cn，见 src/config.ts 的 viewCounterConfig）
     tracker.js 在每次页面浏览时按 location.pathname 向 /send 报一次；它只记路径计数，
     不带 Cookie、不传 UA/IP，所以和 Umami 一样不受 Cookie 同意横幅拦截。
     ⚠️ 这里只负责「写」：不引它的话 D1 里永远是空的，前台所有数字都会是 0。
     读回并渲染由 src/scripts/view-counter-runtime.ts 负责。 -->
{viewCounterConfig.enable && viewCounterConfig.endpoint.trim() !== "" && (
	<script
		is:inline
		defer
		src={`${viewCounterConfig.endpoint.replace(/\/+$/, "")}/tracker.js`}
	></script>
)}

<!-- Umami 统计（Umami Cloud，配置见 src/config.ts 的 umamiConfig）
     consentLevel = "none" 时直出官方追踪代码；否则交给 Cookie 同意横幅按类别执行 -->
{umamiConfig.enable && umamiConfig.consentLevel === "none" && (
	<script
		is:inline
		defer
		src={`${umamiConfig.baseUrl}/script.js`}
		data-website-id={umamiConfig.websiteId}
	></script>
)}
{umamiConfig.enable && umamiConfig.consentLevel !== "none" && (
	<script
		is:inline
		type="text/plain"
		data-cookie-consent={umamiConfig.consentLevel}
		defer
		src={`${umamiConfig.baseUrl}/script.js`}
		data-website-id={umamiConfig.websiteId}
	></script>
)}

<!-- 第三方统计：Google Analytics 4 与 Microsoft Clarity（配置见 src/config.ts 的 analyticsConfig）
     默认（consentLevel: "none"）**页面一打开就加载**，和 Umami、自建计数一致。
     尊重「拒绝」用两层保险：
       ① 页面加载前先读一次 cookie_consent_level —— 访客明确拒绝过「跟踪」的，
          立刻置 ga-disable，并且不再注入 Clarity（下次访问也直接不注入）；
       ② 会话内点「拒绝 / 改偏好」时，再由下面那段同步脚本实时下发停用信号。
     Clarity 的坑：clarity("consent", false) 只对「脚本加载完之后」的调用生效，
     排在加载前队列里的调用会被忽略 —— 所以第 ① 层是必须的，光靠第 ② 层拦不住。
     把 analyticsConfig.consentLevel 改成 "tracking"，这两个标签会变成
     type="text/plain" + data-cookie-consent="tracking"，回到「同意后才加载」。 -->
{!analyticsGated && (gaId || clarityId) && (
	<script is:inline define:vars={{ gaId }}>
	(function () {
		var denied = false;
		var m = document.cookie.match(/(?:^|;\s*)cookie_consent_level=([^;]+)/);
		if (m) {
			try { denied = !JSON.parse(decodeURIComponent(m[1]))["tracking"]; } catch (e) {}
		}
		window.__trackingDenied = denied;
		if (denied && gaId) window["ga-disable-" + gaId] = true;
	})();
	</script>
)}

{/* 埋点脚本延后到 load 之后的空闲时段再加载。
     gtag.js 单个就 170KB+，Clarity 也要再拉一坨 JS；它们和首屏抢带宽与主线程，
     直接拖累 FCP / LCP / TBT（实测 4× CPU 降压下主线程长任务明显变少）。
     延后不影响统计口径 —— pageview 在脚本真正执行时才上报，只是晚一两秒。
     同意状态仍是「默认开启、拒绝即停用」：真正加载前再查一次 __trackingDenied，
     拒绝过的访客一个字节都不会下载。 */}
{!analyticsGated && (gaId || clarityId) && (
	<script is:inline define:vars={{ gaId, clarityId }}>
	(function () {
		var loadAnalytics = function () {
			if (window.__trackingDenied) return;

			if (gaId) {
				window.dataLayer = window.dataLayer || [];
				window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
				window.gtag("js", new Date());
				window.gtag("config", gaId);
				var g = document.createElement("script");
				g.async = true;
				g.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
				document.head.appendChild(g);
			}

			if (clarityId) {
				(function (c, l, a, r, i, t, y) {
					c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
					t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
					y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
				})(window, document, "clarity", "script", clarityId);
			}
		};

		var idle = window.requestIdleCallback || function (fn) { return setTimeout(fn, 1200); };
		if (document.readyState === "complete") idle(loadAnalytics);
		else window.addEventListener("load", function () { idle(loadAnalytics); }, { once: true });
	})();
	</script>
)}

<!-- 会话内改主意时实时开关：读 TermsFeed 写下的 cookie_consent_level.tracking。
     库本身不派发事件，所以用「点横幅里的按钮 → 隔一拍读 cookie」的方式同步。 -->
{!analyticsGated && (gaId || clarityId) && (
	<script is:inline define:vars={{ gaId, clarityId }}>
	(function () {
		var readTracking = function () {
			var m = document.cookie.match(/(?:^|;\s*)cookie_consent_level=([^;]+)/);
			if (!m) return null;
			try {
				return !!JSON.parse(decodeURIComponent(m[1]))["tracking"];
			} catch (e) {
				return null;
			}
		};
		var stop = function () {
			window.__trackingDenied = true;
			if (gaId) window["ga-disable-" + gaId] = true;
			if (clarityId && typeof window.clarity === "function") {
				try { window.clarity("consent", false); } catch (e) {}
			}
		};
		var resume = function () {
			window.__trackingDenied = false;
			if (gaId) window["ga-disable-" + gaId] = false;
			if (clarityId && typeof window.clarity === "function") {
				try { window.clarity("consent"); } catch (e) {}
			}
		};
		var sync = function () {
			var tracking = readTracking();
			if (tracking === null) return; // 用户还没做选择
			tracking ? resume() : stop();
		};
		// 横幅里的按钮点完会写 cookie，隔一拍再读一次
		document.addEventListener("click", function (event) {
			var target = event.target;
			if (!(target instanceof Element)) return;
			if (!target.closest(".cc-window, .cc_dialog, [class*='termsfeed'], #cc-main")) return;
			setTimeout(sync, 300);
		}, true);
	})();
	</script>
)}

<!-- 已移除上游模板的 Browser Update 提示（browser-update.org）。
     它会在每个页面注入一个第三方脚本，把访客的 IP / User-Agent 交给外部服务，
     换来的只是一条"浏览器过旧"的横条 —— 这个站用的都是现代 CSS/JS，旧浏览器本来也
     用不了，为它多一个第三方追踪面不值当。第三方清单见 /privacy/。 -->
