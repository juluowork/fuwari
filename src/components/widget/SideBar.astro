---
import type { MarkdownHeading } from "astro";

import {
	buildTimetableViewModel,
	resolveCurrentWeek,
} from "@/utils/timetable-normalizer";
import { parseTimetableFile } from "@/utils/timetable-parser-server";
import { resolveTimetableFile } from "@/utils/timetable-data";
import LiveTimetableStatus from "@components/timetable/LiveTimetableStatus.astro";
import Profile from "./Profile.astro";

interface Props {
	headings?: MarkdownHeading[];
}

// 课表未配置时，侧栏不显示课表卡片
const timetableFile = resolveTimetableFile();
let sidebarLiveStatusPayload: {
	coursesByDay: ReturnType<typeof buildTimetableViewModel>["coursesByDay"];
} | null = null;

if (timetableFile) {
	try {
		const timetableData = parseTimetableFile(timetableFile);
		const timetableWeek = resolveCurrentWeek(
			timetableData.meta.startDate,
			timetableData.meta.maxWeek,
		);
		const timetableViewModel = buildTimetableViewModel(
			timetableData,
			timetableWeek,
		);
		sidebarLiveStatusPayload = {
			coursesByDay: timetableViewModel.coursesByDay,
		};
	} catch {
		sidebarLiveStatusPayload = null;
	}
}
---

<div id="sidebar-inner" class="w-full">
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="flex flex-col w-full gap-4 sticky top-4" style="top: calc(var(--navbar-offset, 0px) + 1rem);">
        {sidebarLiveStatusPayload && (
        <div id="sidebar-timetable">
            <a href="/timetable/" class="block" aria-label="前往课程表">
                <LiveTimetableStatus payload={sidebarLiveStatusPayload} class="live-status-card" />
            </a>
        </div>
        )}

        <div id="sidebar-deepwiki">
            <a href="https://deepwiki.com/juluowork/fuwari" target="_blank" rel="noopener noreferrer"
               class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-[var(--card-bg)] border-2 border-[var(--primary)] text-[var(--primary)] font-bold text-lg hover:bg-[var(--primary)] hover:text-white shadow-md active:scale-95 group whitespace-nowrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 flex-shrink-0">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                有疑问？询问 DeepWiki！
            </a>
        </div>


    </div>
</div>

