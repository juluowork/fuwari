---
// ⚠️ KaTeX 与 Prism 的样式只在文章页需要（正文里的公式与代码块），
// 之前放在这里会被打进**全站**的关键 CSS —— 实测那个 CSS 因此涨到 311.8KB，
// 在 1.6Mbps 下要 1.6 秒才到，首屏出现明显 FOUC 并造成 CLS。
// 现在移到 src/pages/posts/[...slug].astro 单独引入，首页不再为它们付流量。
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";

import { profileConfig, siteConfig, siteVerificationConfig, umamiConfig } from "@/config";
import StaticBackground from "@components/StaticBackground.astro";
import BodyThirdPartyScripts from "@components/layout/BodyThirdPartyScripts.astro";
import DashLoaderScript from "@components/layout/DashLoaderScript.astro";
import LiquidGlassFilter from "@components/layout/LiquidGlassFilter.astro";

import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { url, pathsEqual } from "../utils/url-utils";
// KaTeX CSS loaded asynchronously via <link> in <head> to avoid blocking render
// import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
}

let { title, banner, description, lang, setOGTypeArticle, ogImage } = Astro.props;

// 分享图：文章自带封面就用它，否则回落到站点默认图（public/og-default.png，1200x630）。
// 之前只在传了 ogImage 时才输出 og:image，而文章 frontmatter 里普遍没有 image 字段，
// 结果全站 28 个页面都没有 og:image —— 分享到群/社交平台时全是纯文字卡片。
const resolvedOgImage = new URL(ogImage || "/og-default.png", Astro.site).toString();
const usingDefaultOgImage = !ogImage;

// apply a class to the body element to decide the height of the banner, only used for initial page load
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));


// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	if (siteConfig.subtitle && siteConfig.subtitle.trim() !== "") {
		pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
	} else {
		pageTitle = siteConfig.title;
	}
}

// Use siteConfig.description as fallback for meta description when no description is provided
if (!description) {
	description = siteConfig.description || pageTitle;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
    <html lang={siteLang} class="bg-[var(--page-bg)] text-[12px] md:text-[16px] dark">

	<head>

		<meta name="referrer" content="unsafe-url" />

		<title>{pageTitle}</title>

		<!-- <meta name="referrer" content="no-referrer"> -->


		<link rel="canonical" href={Astro.url}>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
		<meta name="description" content={description}>
		<meta name="author" content={profileConfig.name}>
		{siteConfig.keywords && (
			<meta name="keywords" content={siteConfig.keywords.join(", ")}>
		)}

		{/* 搜索引擎站长验证（配置见 src/config.ts 的 siteVerificationConfig） */}
		{siteVerificationConfig.bing && (
			<meta name="msvalidate.01" content={siteVerificationConfig.bing} />
		)}
		{siteVerificationConfig.google && (
			<meta name="google-site-verification" content={siteVerificationConfig.google} />
		)}
		{siteVerificationConfig.baidu && (
			<meta name="baidu-site-verification" content={siteVerificationConfig.baidu} />
		)}

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:image:alt" content={pageTitle} />
		{usingDefaultOgImage && (
			<>
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
			</>
		)}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={resolvedOgImage} />

		<meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href={umamiConfig.baseUrl} />
	

<script define:vars={{ customDomain: siteConfig.customDomain }}>
		(function () {
		var hostname = location.hostname;
		var port = location.port;

		// 默认端口判断
		var isDefaultPort =
			port === "" || port === "80" || port === "443";

		if (hostname !== customDomain && isDefaultPort) {
			location.replace(
			`https://${customDomain}` +
			location.pathname +
			location.search +
			location.hash
			);
		}
		})();
		</script>


		
		
		
		{/* <!-- Content Security Policy -->
		<meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app ${umamiConfig.baseUrl}; style-src 'self' 'unsafe-inline' https://giscus.app https://fonts.googleapis.com https://api.iconify.design; font-src 'self' https://fonts.gstatic.com https://api.iconify.design; img-src 'self' data: https: http:; connect-src 'self' ${umamiConfig.baseUrl} https://api.iconify.design https://q2.qlogo.cn; frame-src 'self' https://giscus.app *.bilibili.com; object-src 'none'; base-uri 'self'; form-action 'self';`}> */}
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DARK_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Force dark mode
			document.documentElement.classList.add('dark');
			localStorage.setItem('theme', DARK_MODE);

			// Always use config hue (ignore localStorage)
			document.documentElement.style.setProperty('--hue', configHue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>

		<!-- 零宽短链解码脚本 - 必须在页面加载前执行 -->
		<script is:inline>
		(function(){
			// 固定的零宽前缀标识（ZWSP+ZWNJ+ZWSP+ZWNJ）
			var ZW_PREFIX = '\u200B\u200C\u200B\u200C';
			var ZW_CHARS=['\u200B','\u200C'];
			
			// 从路径中提取内容（去掉开头的 /）
			var pathPart = decodeURIComponent(window.location.pathname.substring(1));
			
			// 调试输出
			console.log('零宽短链检测:', {
				pathname: window.location.pathname,
				pathPart: pathPart,
				pathPartLength: pathPart.length,
				startsWithPrefix: pathPart.startsWith(ZW_PREFIX),
				firstChars: pathPart.substring(0, 10).split('').map(function(c){ return c.charCodeAt(0).toString(16); })
			});
			
			// 检查是否以固定前缀开头
			if(pathPart.startsWith(ZW_PREFIX)){
				console.log('检测到零宽短链！');
				try{
					// 移除前缀，获取编码部分
					var encoded = pathPart.substring(ZW_PREFIX.length);
					
					// 提取零宽字符序列
					var seq=encoded.split('').filter(function(c){
						return c==='\u200B'||c==='\u200C';
					});
					
					console.log('提取到零宽字符数量:', seq.length);
					
					if(seq.length>0){
						// 转换为二进制字符串
						var bin='';
						for(var i=0;i<seq.length;i++){
							bin+=(seq[i]==='\u200B'?'0':'1');
						}
						
						// 转换为字节数组
						var bytes=[];
						for(var i=0;i<bin.length;i+=8){
							var b=bin.slice(i,i+8);
							if(b.length===8){
								bytes.push(parseInt(b,2));
							}
						}
						
						// 解码为 URL
						var url=new TextDecoder().decode(new Uint8Array(bytes));
						console.log('解码后的 URL:', url);
						
						// 验证 URL 格式
						try{
							new URL(url);
							// 显示确认对话框
							if(confirm('即将跳转到：\n' + url + '\n\n请确认这是您信任的网站。')){
								window.location.href=url;
							} else {
								// 用户取消，跳转到首页
								window.location.href='/';
							}
							// 阻止页面继续加载
							return;
						}catch(e){
							console.error('URL 验证失败:', e);
						}
					}
				}catch(e){
					console.error('零宽短链解码失败:', e);
				}
			}
		})();
		</script>
        
        <style define:vars={{ configHue }}>
            /* Fallback for no-js: Apply default theme hue */
            :root {
                --hue: var(--configHue);
            }
        </style>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`
		}}>
		</style>


		<!-- KaTeX 样式在 frontmatter 里 `import "katex/dist/katex.min.css"` 随构建打包
		     （原先指向公共 CDN，国内可达性不稳定；字体也会被 Vite 一起处理成站内资源） -->


		<slot name="head"></slot>


		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>



	</head>
	<body class=" min-h-screen " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}>



<BodyThirdPartyScripts />

		<StaticBackground />

		<slot />

		<DashLoaderScript />
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)]
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script src="../scripts/layout-main-runtime.ts"></script>

<!-- 浏览量读取端：每页一次 POST /batch，回填侧栏「访问量」与各文章卡片的浏览量 -->
<script src="../scripts/view-counter-runtime.ts"></script>

<script src="../scripts/layout-fancybox-runtime.ts"></script>

<script src="../scripts/code-highlight-runtime.ts"></script>

<LiquidGlassFilter />
