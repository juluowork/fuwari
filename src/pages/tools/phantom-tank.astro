---
export const toolMeta = {
	title: "隐藏图 / 幻影图",
	description: "本地生成支持白底/黑底显隐效果的 PNG",
	icon: "material-symbols:layers-rounded",
	order: 4,
};

import PhantomTankGenerator from "@components/PhantomTankGenerator.svelte";
import PageCardHeader from "@components/misc/PageCardHeader.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = "光棱坦克 / 幻影坦克图片工具";
// JSON-LD：让搜索引擎知道这是一个可以直接使用的免费 Web 应用（结构化数据）
const toolJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: "光棱坦克图片工具",
	url: new URL("/tools/phantom-tank/", Astro.site).toString(),
	applicationCategory: "MultimediaApplication",
	operatingSystem: "Any",
	browserRequirements: "需要支持 ES2020 的现代浏览器",
	offers: { "@type": "Offer", price: "0", priceCurrency: "CNY" },
	description: "光棱坦克 / 幻影坦克图片生成器：两张图合成一张，白底与黑底分别显示不同画面。",
};

---

<MainGridLayout
	title={title}
	description="光棱坦克 / 幻影坦克图片生成器：把两张图合成一张，白底显示其中一张、黑底显示另一张，用本地 Canvas 合成，文件不外传。"
>
	<div class="p-6 md:p-8 border-b border-white/10">
		<PageCardHeader title={title} icon="material-symbols:layers-rounded" pathname="/phantom-tank/" />
		<p class="mb-6 text-sm leading-relaxed text-50">
			同页支持光棱坦克与幻影坦克两种模式：可在浏览器本地完成双图上传、生成、预览与 PNG 下载；所有处理均在前端完成，不会上传到服务端。
		</p>
		<PhantomTankGenerator client:visible />
	</div>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(toolJsonLd)}></script>
</MainGridLayout>
